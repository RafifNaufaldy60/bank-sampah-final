PORT=3000
CLIENT_ORIGIN=http://localhost:5173
# Gunakan connection string dari Neon. Jangan commit file .env.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full
SESSION_HOURS=24
# Wajib untuk tes DB: database TERPISAH. Tidak ada fallback ke DATABASE_URL.
# Runner membuat schema bs_test_* hanya pada TEST_DATABASE_URL.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@TEST_HOST/TEST_DB?sslmode=verify-full

# Bootstrap dua ketua pilihan pemilik. Isi lokal; jangan commit rahasia.
# Mode create: NAMA dan PASSWORD wajib. Mode existing: hanya MODE dan EMAIL.
# KETUA_1_MODE=create
# KETUA_1_EMAIL=ketua1@example.test
# KETUA_1_NAMA=Ketua Pertama
# KETUA_1_PASSWORD=<ISI_SECARA_LOKAL>
# KETUA_2_MODE=existing
# KETUA_2_EMAIL=ketua2@example.test
